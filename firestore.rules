rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Community Trips & Expeditions
    match /trips/{tripId} {
      allow read, write, create, update, delete: if isValidId(tripId);
    }

    // River Passports and Catalog Routes
    match /routes/{routeId} {
      allow read, write, create, update, delete: if isValidId(routeId);
    }

    // User Accounts & Permissions
    match /users/{userId} {
      allow read, write, create, update, delete: if isValidId(userId);
    }

    // Articles, Guides & Trip Reports
    match /articles/{articleId} {
      allow read, write, create, update, delete: if isValidId(articleId);
    }

    // Hydrological Stations & Water Levels
    match /hydro/{stationId} {
      allow read, write, create, update, delete: if isValidId(stationId);
    }

    // FAQ, Safety Handbook, Radio & Emergency Communications
    match /faq/{docId} {
      allow read, write, create, update, delete: if isValidId(docId);
    }

    // Travel Notes, Checklists, Logbook & 5-Star Reviews
    match /travel_notes/{docId} {
      allow read, write, create, update, delete: if isValidId(docId);
    }

    // Catch-all for subcollections or nested paths
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
