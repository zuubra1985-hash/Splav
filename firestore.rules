rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helper primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Safe connection test doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Tourist Profiles (Visible to all community members for sync, writable with valid ID)
    match /users/{userId} {
      allow read, list: if true;
      allow write: if isValidId(userId);
    }

    // Community River Routes & Waterway Passports (Shared across all users)
    match /routes/{routeId} {
      allow read, list: if true;
      allow write: if isValidId(routeId);
    }

    // Expeditions & Companion Search Trips (Shared across all users in real-time)
    match /trips/{tripId} {
      allow read, list: if true;
      allow write: if isValidId(tripId);

      // Instant Trip Chat Subcollection
      match /messages/{msgId} {
        allow read, list: if true;
        allow write: if isValidId(msgId);
      }

      // Live Presence Subcollection
      match /presence/{userId} {
        allow read, list: if true;
        allow write: if isValidId(userId);
      }
    }

    // Articles, Reports & River Guides
    match /articles/{articleId} {
      allow read, list: if true;
      allow write: if isValidId(articleId);
    }

    // FAQ, Safety Handbook, Radio & Emergency Communications
    match /faq/{docId} {
      allow read, list: if true;
      allow write: if isValidId(docId);
    }

    // Travel Notes, Checklists, Logbook & Community Reviews (Shared & Synchronized for everyone)
    match /travel_notes/{docId} {
      allow read, list: if true;
      allow write: if isValidId(docId);
    }
  }
}

