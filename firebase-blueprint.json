{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "Shared water tourism trip / expedition with companion search and chat",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "riverName": { "type": "string", "maxLength": 150 },
        "region": { "type": "string", "maxLength": 50 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "durationDays": { "type": "number" },
        "vesselType": { "type": "string", "maxLength": 50 },
        "requiredVessels": { "type": "array" },
        "difficulty": { "type": "string", "maxLength": 50 },
        "estimatedBudgetPerPerson": { "type": "number" },
        "totalSeats": { "type": "number" },
        "takenSeats": { "type": "number" },
        "creator": { "type": "object" },
        "description": { "type": "string", "maxLength": 5000 },
        "routeHighlights": { "type": "array" },
        "startCoords": { "type": "object" },
        "endCoords": { "type": "object" },
        "meetingPoint": { "type": "string", "maxLength": 300 },
        "chatMessages": { "type": "array" },
        "participants": { "type": "array" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string", "maxLength": 100 },
        "gpxTrack": { "type": "object" },
        "linkedRouteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "riverName", "startDate", "durationDays"]
    },
    "Route": {
      "title": "Route",
      "description": "River passport, waterway description and GPS trace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "riverName": { "type": "string", "maxLength": 150 },
        "riverBasin": { "type": "string", "maxLength": 150 },
        "region": { "type": "string", "maxLength": 50 },
        "fstrCategory": { "type": "string", "maxLength": 50 },
        "intlClass": { "type": "string", "maxLength": 50 },
        "lengthKm": { "type": "number" },
        "durationDays": { "type": "number" },
        "recommendedVessels": { "type": "array" },
        "startPoint": { "type": "object" },
        "endPoint": { "type": "object" },
        "coordinates": { "type": "array" },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDesc": { "type": "string", "maxLength": 1000 },
        "highlights": { "type": "array" },
        "warnings": { "type": "array" },
        "pois": { "type": "array" },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "mchsRegistrationRequired": { "type": "boolean" },
        "kmnsPermitNeeded": { "type": "boolean" }
      },
      "required": ["id", "name", "riverName", "lengthKm", "coordinates"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered tourist / user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "experienceLevel": { "type": "string", "maxLength": 100 },
        "registeredAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "email"]
    },
    "FaqConfig": {
      "title": "FaqConfig",
      "description": "FAQ data configuration, safety handbook, and emergency communications",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "warningTitle": { "type": "string", "maxLength": 300 },
        "warningText": { "type": "string", "maxLength": 2000 },
        "sosTemplateText": { "type": "string", "maxLength": 1000 },
        "cheatSheetContent": { "type": "string", "maxLength": 10000 },
        "emergencyContacts": { "type": "array" },
        "radioFrequencies": { "type": "array" },
        "visualSignals": { "type": "array" },
        "safetyGuides": { "type": "array" },
        "faqQuestions": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title"]
    },
    "TravelNotesConfig": {
      "title": "TravelNotesConfig",
      "description": "Travel notes, checklists, logbook trips, river ratings and crew reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "notes": { "type": "array" },
        "checklist": { "type": "array" },
        "logbookTrips": { "type": "array" },
        "riverReviews": { "type": "array" },
        "crewReviews": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id"]
    },
    "Article": {
      "title": "Article",
      "description": "Expedition report, river guide, lotiya and tourist article",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "riverName": { "type": "string", "maxLength": 150 },
        "region": { "type": "string", "maxLength": 50 },
        "author": { "type": "string", "maxLength": 150 },
        "authorRank": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 100 },
        "readTimeMin": { "type": "number" },
        "coverImage": { "type": "string", "maxLength": 500000 },
        "summary": { "type": "string", "maxLength": 2000 },
        "fullContent": { "type": "array" },
        "tags": { "type": "array" },
        "stats": { "type": "object" },
        "gallery": { "type": "array" }
      },
      "required": ["id", "title", "riverName"]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Public water tourism trips and expeditions"
    },
    "/routes/{routeId}": {
      "schema": { "$ref": "#/entities/Route" },
      "description": "Community river passports and GPS tracks"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Tourist and admin user accounts"
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Articles, expedition reports and river pilot guides"
    },
    "/faq/{docId}": {
      "schema": { "$ref": "#/entities/FaqConfig" },
      "description": "FAQ content, safety rules, emergency contacts and radio frequencies"
    },
    "/travel_notes/{docId}": {
      "schema": { "$ref": "#/entities/TravelNotesConfig" },
      "description": "Travel notes, equipment checklists, logbook trips, river and crew reviews"
    }
  }
}
